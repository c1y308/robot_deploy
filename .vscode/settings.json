{
    "cmake.configureOnOpen": false,
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-arm64",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/src/inference/build-onnx/compile_commands.json",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/src/base/include",
        "${workspaceFolder}/src/motors/include",
        "${workspaceFolder}/src/motors/src/drivers/myact",
        "${workspaceFolder}/src/motors/src/protocol/ethercat",
        "${workspaceFolder}/src/inference/include",
        "${workspaceFolder}/src/inference/third_party/onnxruntime-1.30.0/include",
        "${workspaceFolder}/src/imu/include",
        "${workspaceFolder}/src/xbox_control/include",
        "${workspaceFolder}/src/**",
        "/home/cat/ethercat/include",
        "/opt/etherlab/include",
        "/usr/include",
        "/usr/local/include"
    ],
    "C_Cpp.default.browse.path": [
        "${workspaceFolder}/src/base/include",
        "${workspaceFolder}/src/motors/include",
        "${workspaceFolder}/src/motors/src/drivers/myact",
        "${workspaceFolder}/src/motors/src/protocol/ethercat",
        "${workspaceFolder}/src/inference/include",
        "${workspaceFolder}/src/inference/third_party/onnxruntime-1.30.0/include",
        "${workspaceFolder}/src/imu/include",
        "${workspaceFolder}/src/xbox_control/include",
        "${workspaceFolder}/src",
        "/home/cat/ethercat/include",
        "/opt/etherlab/include",
        "/usr/include",
        "/usr/local/include"
    ],
    "clangd.arguments": [
        "--background-index",
        "--header-insertion=never"
    ],
    "clangd.fallbackFlags": [
        "-std=c++17",
        "-I${workspaceFolder}/src/base/include",
        "-I${workspaceFolder}/src/motors/include",
        "-I${workspaceFolder}/src/motors/src/drivers/myact",
        "-I${workspaceFolder}/src/motors/src/protocol/ethercat",
        "-I${workspaceFolder}/src/inference/include",
        "-I${workspaceFolder}/src/inference/third_party/onnxruntime-1.30.0/include",
        "-I${workspaceFolder}/src/imu/include",
        "-I${workspaceFolder}/src/xbox_control/include",
        "-I/home/cat/ethercat/include",
        "-I/opt/etherlab/include"
    ]
}
