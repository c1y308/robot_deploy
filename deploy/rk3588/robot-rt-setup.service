[Unit]
Description=Apply and verify RK3588 robot real-time CPU layout
After=systemd-modules-load.service irqbalance.service NetworkManager.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/robot-rt-setup apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
